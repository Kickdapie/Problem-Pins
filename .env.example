# Copy to .env.local (never commit it). Without the Supabase values the app runs in demo mode.

# demo = sample data in this browser; live = shared Supabase data. Default: live when Supabase is set.
# Any deployment can still show the demo with ?mode=demo in the URL.
VITE_DATA_MODE=

# From Supabase: Project Settings → API Keys, or `supabase status` for the local stack
# (local: http://127.0.0.1:54321 and the publishable key). Setup steps: docs/BACKEND.md.
# The publishable (anon) key is public by design; Row Level Security protects the data.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which district this deployment serves (districts.id in the database). The sample seed is west-side-demo.
VITE_DISTRICT_ID=

# Base URL printed on QR posters, e.g. https://problempins.org (defaults to the current origin).
VITE_PUBLIC_URL=

# on = resident screens ask for a phone or email and promise a message when a problem changes.
# Leave empty until something actually sends those messages (docs/BACKEND.md, wave 2).
VITE_NOTIFICATIONS=

# on = residents may add an email (optional account, 6-digit code) to keep their problems on any phone.
# Needs the Supabase project to send email through a real provider, with "Confirm email" on and the
# code templates in place (docs/BACKEND.md, "Resident accounts"). The demo always has accounts.
VITE_RESIDENT_ACCOUNTS=

# Map tiles (Leaflet URL template + attribution HTML). Options and costs: docs/MAP_TILES.md.
# Empty = Stadia Maps without a key, which works on localhost only. Deployments must set these, e.g.
#   VITE_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}{r}.png?key=YOUR_CARTO_KEY
#   VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
