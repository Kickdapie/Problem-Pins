{
  "name": "problem-pins",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed-sql": "node --import ./scripts/ts-hooks.ts scripts/generate-seed.ts",
    "db:reset": "supabase db reset && npm run db:local-staff && npm run db:restart-gateway",
    "db:local-staff": "supabase db query --local -f supabase/seed-local-staff.sql",
    "db:restart-gateway": "docker restart supabase_kong_problem-pins"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
